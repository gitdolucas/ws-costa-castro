# Site
NEXT_PUBLIC_SITE_URL=https://www.costacastro.com.br
NEXT_PUBLIC_WHATSAPP=5521984588952
NEXT_PUBLIC_SITE_INDEXAVEL=0

# Mídia (Blob privado ws-costa-castro-blob)
# O site serve arquivos via /api/media/… — não use URL *.private.blob.* no HTML.
# Opcional: URL absoluta do proxy (útil em e-mails ou OG). Se omitido, usa /api/media.
# MEDIA_CDN_BASE=https://www.costacastro.com.br/api/media

# Local: após `vercel link` + `vercel env pull`, o token do Blob vem do projeto costa-castro-preview.
# BLOB_READ_WRITE_TOKEN=

# Catálogo legado (rotas redirecionadas na v1)
CARA_CERTA_USE_FIXTURE=1
